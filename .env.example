# Neon Postgres — use the POOLED connection string (the -pooler host).
# Neon Console -> project "fintrack" -> Connect.
# Local development should point at the `dev` branch, never `main`.
DATABASE_URL="postgresql://<user>:<password>@ep-xxxx-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/fintrack?sslmode=require"

# Direct (unpooled) connection, for DDL only: npm run db:schema
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@ep-xxxx-xxxx.c-3.ap-southeast-1.aws.neon.tech/fintrack?sslmode=require"

# Passcode gate. The app has no multi-user auth; this single shared passcode is
# what stops the public internet from writing to your transactions.
# Set both of these in Vercel too. No defaults exist in code — a missing
# APP_PASSCODE fails closed and rejects every request.
APP_PASSCODE="change-me"

# HMAC key used to sign the session cookie. Generate a fresh one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-64-hex-chars"
