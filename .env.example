# Neon Postgres — use the POOLED connection string (the -pooler host).
# Neon Console -> project "fintrack" -> Connect.
# Local development should point at the `dev` branch, never `main`.
#
# Note sslmode=verify-full rather than the sslmode=require Neon hands you.
# pg currently treats 'require' as an alias for 'verify-full' but warns that it
# will adopt weaker libpq semantics in pg v9; verify-full is explicit, silences
# the warning, and matches what server/utils/db.ts enforces in code anyway.
DATABASE_URL="postgresql://<user>:<password>@ep-xxxx-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/fintrack?sslmode=verify-full"

# Direct (unpooled) connection — DDL only: npm run db:schema
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@ep-xxxx-xxxx.c-3.ap-southeast-1.aws.neon.tech/fintrack?sslmode=verify-full"

# Passcode gate. The app has no per-user accounts; this single shared passcode
# is what stops the public internet from writing to your transactions.
# Set this in Vercel too. There is no default in code — a missing APP_PASSCODE
# fails closed and rejects every request.
APP_PASSCODE="change-me"

# HMAC key for signing the session cookie. Generate a fresh one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-64-hex-chars"
